{
  "uid": "kubequiz",
  "title": "KubeQuiz: scaling overview",
  "tags": ["kubequiz"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": {"from": "now-30m", "to": "now"},
  "panels": [
    {
      "id": 1, "type": "stat", "title": "Ready replicas",
      "gridPos": {"x": 0, "y": 0, "w": 4, "h": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(kube_deployment_status_replicas_available{namespace=\"kubequiz\", deployment=\"quiz-app\"})"}],
      "options": {"colorMode": "background", "graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"color": {"mode": "fixed", "fixedColor": "blue"}}}
    },
    {
      "id": 2, "type": "stat", "title": "Requests / s",
      "gridPos": {"x": 4, "y": 0, "w": 4, "h": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(rate(flask_http_request_total{namespace=\"kubequiz\"}[1m]))"}],
      "options": {"graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"unit": "reqps", "decimals": 1}}
    },
    {
      "id": 3, "type": "stat", "title": "Avg CPU vs request (HPA target 50%)",
      "gridPos": {"x": 8, "y": 0, "w": 5, "h": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "kube_horizontalpodautoscaler_status_target_metric{namespace=\"kubequiz\", horizontalpodautoscaler=\"quiz-app\", metric_target_type=\"utilization\"}"}],
      "options": {"graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"unit": "percent", "thresholds": {"mode": "absolute", "steps": [
        {"color": "green", "value": null}, {"color": "orange", "value": 50}, {"color": "red", "value": 90}]}}}
    },
    {
      "id": 4, "type": "stat", "title": "Quiz submissions / min",
      "gridPos": {"x": 13, "y": 0, "w": 5, "h": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(rate(kubequiz_submissions_total{namespace=\"kubequiz\"}[1m])) * 60"}],
      "options": {"graphMode": "area", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"decimals": 0}}
    },
    {
      "id": 5, "type": "stat", "title": "5xx errors / s",
      "gridPos": {"x": 18, "y": 0, "w": 6, "h": 5},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "expr": "sum(rate(flask_http_request_total{namespace=\"kubequiz\", status=~\"5..\"}[1m])) or vector(0)"}],
      "options": {"colorMode": "background", "reduceOptions": {"calcs": ["lastNotNull"]}},
      "fieldConfig": {"defaults": {"unit": "reqps", "decimals": 2, "thresholds": {"mode": "absolute", "steps": [
        {"color": "green", "value": null}, {"color": "red", "value": 0.1}]}}}
    },
    {
      "id": 6, "type": "timeseries", "title": "Replicas: current vs desired (HPA)",
      "gridPos": {"x": 0, "y": 5, "w": 12, "h": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "legendFormat": "current", "expr": "kube_horizontalpodautoscaler_status_current_replicas{namespace=\"kubequiz\", horizontalpodautoscaler=\"quiz-app\"}"},
        {"refId": "B", "legendFormat": "desired", "expr": "kube_horizontalpodautoscaler_status_desired_replicas{namespace=\"kubequiz\", horizontalpodautoscaler=\"quiz-app\"}"},
        {"refId": "C", "legendFormat": "max", "expr": "kube_horizontalpodautoscaler_spec_max_replicas{namespace=\"kubequiz\", horizontalpodautoscaler=\"quiz-app\"}"}
      ],
      "fieldConfig": {"defaults": {"min": 0, "decimals": 0, "custom": {"lineWidth": 2, "lineInterpolation": "stepAfter"}},
        "overrides": [{"matcher": {"id": "byName", "options": "max"}, "properties": [
          {"id": "custom.lineStyle", "value": {"fill": "dash", "dash": [6, 6]}}, {"id": "color", "value": {"mode": "fixed", "fixedColor": "gray"}}]}]}
    },
    {
      "id": 7, "type": "timeseries", "title": "CPU per pod (% of 100m request)",
      "gridPos": {"x": 12, "y": 5, "w": 12, "h": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "legendFormat": "{{pod}}", "expr": "100 * sum by (pod) (rate(container_cpu_usage_seconds_total{namespace=\"kubequiz\", container=\"app\"}[1m])) / on (pod) sum by (pod) (kube_pod_container_resource_requests{namespace=\"kubequiz\", container=\"app\", resource=\"cpu\"})"}],
      "fieldConfig": {"defaults": {"unit": "percent", "min": 0, "custom": {"lineWidth": 1}}}
    },
    {
      "id": 8, "type": "timeseries", "title": "Requests / s per pod",
      "gridPos": {"x": 0, "y": 14, "w": 12, "h": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [{"refId": "A", "legendFormat": "{{pod}}", "expr": "sum by (pod) (rate(flask_http_request_total{namespace=\"kubequiz\"}[1m]))"}],
      "fieldConfig": {"defaults": {"unit": "reqps", "min": 0, "custom": {"stacking": {"mode": "normal"}, "fillOpacity": 30}}}
    },
    {
      "id": 9, "type": "timeseries", "title": "Latency (p50 / p95)",
      "gridPos": {"x": 12, "y": 14, "w": 12, "h": 9},
      "datasource": {"type": "prometheus", "uid": "prometheus"},
      "targets": [
        {"refId": "A", "legendFormat": "p50", "expr": "histogram_quantile(0.50, sum by (le) (rate(flask_http_request_duration_seconds_bucket{namespace=\"kubequiz\"}[1m])))"},
        {"refId": "B", "legendFormat": "p95", "expr": "histogram_quantile(0.95, sum by (le) (rate(flask_http_request_duration_seconds_bucket{namespace=\"kubequiz\"}[1m])))"}
      ],
      "fieldConfig": {"defaults": {"unit": "s", "min": 0}}
    }
  ]
}
